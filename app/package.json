{
  "name": "karyavahi-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "db:build": "node --experimental-sqlite scripts/build-db.mjs",
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "setup": "npm run db:build && npm run typecheck",
    "verify": "bash scripts/verify.sh",
    "verify:full": "bash scripts/verify.sh --full",
    "restart": "bash scripts/restart.sh",
    "smoke": "tsx --conditions=react-server scripts/smoke.ts",
    "test:write": "tsx --conditions=react-server scripts/write-test.mts",
    "test:session": "tsx --conditions=react-server scripts/session-test.mts",
    "test:authority": "tsx --conditions=react-server scripts/authority-test.mts",
    "test:integrity": "tsx --conditions=react-server scripts/integrity-test.mts",
    "test:scope": "tsx --conditions=react-server scripts/scope-test.mts",
    "test:plan": "tsx --conditions=react-server scripts/plan-test.mts",
    "crawl": "node scripts/crawl.mjs",
    "e2e": "node scripts/e2e.cjs",
    "db:init": "node scripts/db-init.mjs",
    "predev": "node scripts/db-init.mjs",
    "prestart": "node scripts/db-init.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "maplibre-gl": "^5.24.0",
    "next": "15.5.28",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "autoprefixer": "10.4.20",
    "playwright-core": "^1.64.1",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "tsx": "^4.19.2",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
